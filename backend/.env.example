# 环境变量配置
# 复制此文件为 .env 并修改配置

# Django
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# 数据库配置
DB_NAME=hospital_checkup
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# 开发时可使用 SQLite
USE_SQLITE=True

# 跨域配置
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
