<view class="container">
  <view class="header">
    <text class="title">预约管理</text>
    <view class="actions">
      <button size="mini" bindtap="goDashboard">控制台</button>
      <button size="mini" bindtap="goPackages">套餐</button>
    </view>
  </view>

  <picker mode="selector" range="{{statusOptions}}" range-key="label" bindchange="onStatusChange">
    <view class="filter">筛选状态：{{statusOptions[statusIndex].label}}</view>
  </picker>

  <view wx:if="{{loading}}" class="empty">加载中...</view>

  <block wx:elif="{{list.length}}">
    <view class="card item" wx:for="{{list}}" wx:key="id">
      <view class="line"><text>{{item.order_no}}</text><text class="tag">{{statusMap[item.status]}}</text></view>
      <view class="line"><text>体检人：{{item.name}}</text><text>电话：{{item.phone}}</text></view>
      <view class="line"><text>日期：{{item.appointment_date}}</text><text>时段：{{item.time_slot}}</text></view>
      <view class="line"><text>金额：¥{{item.amount}}</text></view>

      <view class="btns" wx:if="{{item.status === 0}}">
        <button size="mini" type="primary" loading="{{actionLoading}}" data-id="{{item.id}}" bindtap="onApprove">确认</button>
        <button size="mini" type="warn" loading="{{actionLoading}}" data-id="{{item.id}}" bindtap="onReject">拒绝</button>
      </view>
    </view>

    <view wx:if="{{loadingMore}}" class="load-more">加载更多...</view>
    <view wx:elif="{{!hasMore}}" class="load-more">已加载全部（{{total}}）</view>
  </block>

  <view wx:else class="empty">暂无预约数据</view>
</view>
