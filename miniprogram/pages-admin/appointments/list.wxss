.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.title {
  font-size: 34rpx;
  font-weight: 600;
}

.actions {
  display: flex;
  gap: 8rpx;
}

.filter {
  padding: 18rpx 20rpx;
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.item {
  margin-bottom: 16rpx;
}

.line {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
  font-size: 26rpx;
}

.tag {
  color: #2563eb;
}

.btns {
  display: flex;
  gap: 12rpx;
  margin-top: 10rpx;
}

