<view class="container">
  <view class="header">
    <text class="title">文章管理</text>
    <view class="actions">
      <button size="mini" type="primary" bindtap="onAdd">新增</button>
      <button size="mini" bindtap="goDashboard">控制台</button>
    </view>
  </view>

  <view wx:if="{{loading}}" class="empty">加载中...</view>

  <block wx:elif="{{list.length}}">
    <view class="card item" wx:for="{{list}}" wx:key="id">
      <view class="line">
        <text class="name">{{item.title}}</text>
        <text class="status {{item.is_active ? 'on' : 'off'}}">{{item.is_active ? '已发布' : '已下线'}}</text>
      </view>
      <view class="meta">浏览量：{{item.views_count || 0}} | 创建：{{item.created_at || '-'}}</view>
      <view class="desc">{{item.content || '暂无正文'}}</view>
      <view class="item-actions">
        <button size="mini" data-id="{{item.id}}" data-title="{{item.title}}" bindtap="onEdit">编辑</button>
        <button size="mini" data-id="{{item.id}}" data-active="{{item.is_active}}" bindtap="onToggleActive">{{item.is_active ? '下线' : '发布'}}</button>
        <button size="mini" type="warn" data-id="{{item.id}}" bindtap="onDelete">删除</button>
      </view>
    </view>

    <view wx:if="{{loadingMore}}" class="load-more">加载更多...</view>
    <view wx:elif="{{!hasMore}}" class="load-more">已加载全部（{{total}}）</view>
  </block>

  <view wx:else class="empty">暂无文章数据</view>
</view>

