.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.title {
  font-size: 34rpx;
  font-weight: 600;
}

.actions {
  display: flex;
  gap: 8rpx;
}

.item {
  margin-bottom: 16rpx;
}

.preview {
  width: 100%;
  height: 220rpx;
  border-radius: 10rpx;
  margin-bottom: 12rpx;
  background: #f3f4f6;
}

.line {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.name {
  font-size: 30rpx;
  font-weight: 600;
}

.meta,
.link {
  color: #6b7280;
  font-size: 24rpx;
  margin-bottom: 8rpx;
}

.status {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
}

.status.on {
  color: #047857;
  background: #d1fae5;
}

.status.off {
  color: #9f1239;
  background: #ffe4e6;
}

.item-actions {
  display: flex;
  gap: 10rpx;
  margin-top: 12rpx;
}

.load-more {
  text-align: center;
  color: #6b7280;
  font-size: 24rpx;
  padding: 20rpx 0 30rpx;
}

