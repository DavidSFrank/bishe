.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.title {
  font-size: 34rpx;
  font-weight: 600;
}

.item {
  margin-bottom: 16rpx;
}

.line {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.status {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
}

.status.pending {
  background: #fef3c7;
  color: #92400e;
}

.status.replied {
  background: #d1fae5;
  color: #047857;
}

.time {
  color: #6b7280;
  font-size: 24rpx;
}

.content,
.reply,
.user {
  margin-bottom: 8rpx;
  font-size: 26rpx;
  color: #374151;
}

.item-actions {
  display: flex;
  gap: 10rpx;
  margin-top: 12rpx;
}

.load-more {
  text-align: center;
  color: #6b7280;
  font-size: 24rpx;
  padding: 20rpx 0 30rpx;
}

.filter {
  padding: 18rpx 20rpx;
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}
