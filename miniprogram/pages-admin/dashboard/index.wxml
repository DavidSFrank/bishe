<view class="container">
  <view class="header">
    <text class="title">管理控制台</text>
    <view class="actions">
      <button size="mini" bindtap="goPackages">套餐</button>
      <button size="mini" bindtap="goAppointments">预约</button>
      <button size="mini" bindtap="goLogout">退出</button>
    </view>
  </view>

  <view class="grid">
    <view class="card stat-item">
      <text class="label">今日预约</text>
      <text class="value">{{stats.todayAppointments || 0}}</text>
    </view>
    <view class="card stat-item">
      <text class="label">待审核</text>
      <text class="value warning">{{stats.pendingAppointments || 0}}</text>
    </view>
    <view class="card stat-item">
      <text class="label">用户总数</text>
      <text class="value">{{stats.totalUsers || 0}}</text>
    </view>
    <view class="card stat-item">
      <text class="label">套餐总数</text>
      <text class="value">{{stats.totalPackages || 0}}</text>
    </view>
  </view>
</view>

