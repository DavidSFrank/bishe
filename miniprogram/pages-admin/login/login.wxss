.login-page {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
}

.login-card {
  width: 100%;
}

.title {
  text-align: center;
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 30rpx;
}

.input {
  height: 88rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  padding: 0 24rpx;
  margin-bottom: 20rpx;
  background: #fff;
}

