.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.title {
  font-size: 34rpx;
  font-weight: 600;
}

.package-item {
  margin-bottom: 16rpx;
}

.row-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.name {
  font-size: 30rpx;
  font-weight: 600;
}

.meta {
  color: #6b7280;
  font-size: 24rpx;
  margin-bottom: 8rpx;
}

.desc {
  color: #374151;
  font-size: 26rpx;
}

.actions {
  display: flex;
  gap: 8rpx;
}
