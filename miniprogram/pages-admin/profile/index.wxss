.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.title {
  font-size: 34rpx;
  font-weight: 600;
}

.actions {
  display: flex;
  gap: 8rpx;
}

.line {
  margin-bottom: 10rpx;
  font-size: 26rpx;
  color: #374151;
}

.field-title {
  margin-top: 18rpx;
  margin-bottom: 8rpx;
  font-size: 26rpx;
}

.input {
  height: 82rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  padding: 0 20rpx;
  margin-bottom: 12rpx;
  background: #fff;
}

