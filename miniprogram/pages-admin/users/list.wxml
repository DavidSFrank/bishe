<view class="container">
  <view class="header">
    <text class="title">用户管理</text>
    <view class="actions">
      <button size="mini" bindtap="goDashboard">控制台</button>
    </view>
  </view>

  <view wx:if="{{loading}}" class="empty">加载中...</view>

  <block wx:elif="{{list.length}}">
    <view class="card item" wx:for="{{list}}" wx:key="id">
      <view class="line"><text>ID：{{item.id}}</text><text>昵称：{{item.nickname || '用户'}}</text></view>
      <view class="line"><text>姓名：{{item.real_name || '未填写'}}</text><text>手机：{{item.phone || '未绑定'}}</text></view>
      <view class="line"><text>状态：{{item.is_active ? '正常' : '禁用'}}</text><text>注册：{{item.created_at || '-'}}</text></view>
    </view>
    <view wx:if="{{loadingMore}}" class="load-more">加载更多中...</view>
    <view wx:elif="{{!hasMore}}" class="load-more">已加载全部（{{total}}）</view>
  </block>

  <view wx:else class="empty">暂无用户数据</view>
</view>
