.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.title {
  font-size: 34rpx;
  font-weight: 600;
}

.actions {
  display: flex;
  gap: 8rpx;
}

.filters {
  margin-bottom: 16rpx;
}

.search-input {
  background: #f9fafb;
  border-radius: 10rpx;
  padding: 16rpx;
  margin-bottom: 12rpx;
  font-size: 26rpx;
}

.status-bar {
  display: flex;
  gap: 10rpx;
  margin-bottom: 12rpx;
}

.status-item {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #f3f4f6;
  color: #666;
  font-size: 24rpx;
}

.status-item.active {
  background: #e3f2fd;
  color: #1976d2;
}

.filter-actions {
  display: flex;
  justify-content: flex-end;
  gap: 10rpx;
}

.item {
  margin-bottom: 16rpx;
}

.line {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
  font-size: 26rpx;
}

.item-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 8rpx;
}

.load-more {
  text-align: center;
  color: #6b7280;
  font-size: 24rpx;
  padding: 20rpx 0 30rpx;
}

