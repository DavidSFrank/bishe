.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.title {
  font-size: 34rpx;
  font-weight: 600;
}

.item {
  margin-bottom: 16rpx;
}

.line {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
  font-size: 26rpx;
}

.item-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 8rpx;
}

.load-more {
  text-align: center;
  color: #6b7280;
  font-size: 24rpx;
  padding: 20rpx 0 30rpx;
}

.empty {
  text-align: center;
  color: #9ca3af;
  padding: 80rpx 0;
}

