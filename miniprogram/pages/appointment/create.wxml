<view class="create-page">
  <view class="package-info card"><text class="name">{{packageName}}</text><text class="price">{{price}}</text></view>
  <view class="form card">
    <view class="form-item"><text class="label">姓名</text><input placeholder="请输入体检人姓名" data-field="name" bindinput="onInput"/></view>
    <view class="form-item"><text class="label">手机</text><input placeholder="请输入手机号" type="number" data-field="phone" bindinput="onInput"/></view>
    <view class="form-item"><text class="label">身份证</text><input placeholder="请输入身份证号" data-field="id_card" bindinput="onInput"/></view>
    <view class="form-item"><text class="label">性别</text>
      <radio-group bindchange="onGenderChange"><radio value="1" checked>男</radio><radio value="2">女</radio></radio-group>
    </view>
    <view class="form-item"><text class="label">日期</text>
      <picker mode="date" start="{{today}}" bindchange="onDateChange"><text>{{dateStr || '请选择日期'}}</text></picker>
    </view>
    <view class="form-item"><text class="label">时间</text>
      <picker mode="selector" range="{{timeSlots}}" bindchange="onTimeChange"><text>{{timeSlotIndex >= 0 ? timeSlots[timeSlotIndex] : '请选择时间'}}</text></picker>
    </view>
  </view>
  <button class="btn-primary submit-btn" bindtap="onSubmit">提交预约</button>
</view>
