<view class="list-page">
  <view class="filter-bar">
    <view
      class="filter-item {{selectedStatus === item.value ? 'active' : ''}}"
      wx:for="{{statusFilters}}"
      wx:key="value"
      data-value="{{item.value}}"
      bindtap="onFilterChange"
    >{{item.label}}</view>
  </view>

  <view class="error" wx:if="{{errorText}}" bindtap="onRetry">{{errorText}}</view>

  <view class="card" wx:for="{{appointments}}" wx:key="id">
    <view class="header"><text class="name">{{item.package.name}}</text><text class="status status-{{item.status}}">{{statusMap[item.status]}}</text></view>
    <view class="info"><text>体检人：{{item.name}}</text><text>日期：{{item.appointment_date}} {{item.time_slot}}</text></view>
    <view class="meta"><text>订单号：{{item.order_no}}</text><text>下单时间：{{item.created_at}}</text></view>
    <view class="reject" wx:if="{{item.status === 4 && item.reject_reason}}">拒绝原因：{{item.reject_reason}}</view>
    <view class="amount">¥{{item.amount}}</view>
    <view class="actions" wx:if="{{item.status === 0}}">
      <button class="cancel-btn" size="mini" catchtap="onCancel" data-id="{{item.id}}" loading="{{cancelingId === item.id}}">取消预约</button>
    </view>
    <view class="actions" wx:if="{{item.status === 2}}">
      <button class="report-btn" size="mini" catchtap="onGoReportList" data-appointment-id="{{item.id}}">去报告列表</button>
    </view>
  </view>
  <view class="footer" wx:if="{{appointments.length > 0}}">
    <text wx:if="{{loadingMore}}">加载中...</text>
    <text wx:elif="{{!hasMore}}">没有更多了</text>
  </view>
  <view class="empty" wx:if="{{!loading && appointments.length === 0}}"><text>暂无预约记录</text></view>
</view>
