.list-page { padding: 20rpx; }
.card { margin-bottom: 20rpx; }
.header { display: flex; justify-content: space-between; margin-bottom: 16rpx; }
.name { font-weight: bold; font-size: 30rpx; }
.status { font-size: 24rpx; padding: 4rpx 12rpx; border-radius: 4rpx; }
.status-0 { background: #fff3e0; color: #ff9800; }
.status-1 { background: #e3f2fd; color: #2196f3; }
.status-2 { background: #e8f5e9; color: #4caf50; }
.status-3, .status-4 { background: #fce4ec; color: #f44336; }
.info { color: #666; font-size: 26rpx; display: flex; flex-direction: column; gap: 8rpx; }
.amount { margin-top: 16rpx; color: #f44336; font-weight: bold; font-size: 32rpx; }
