.list-page { padding: 20rpx; }
.filter-bar { display: flex; gap: 12rpx; overflow-x: auto; margin-bottom: 20rpx; }
.filter-item { padding: 10rpx 20rpx; border-radius: 999rpx; background: #f5f5f5; color: #666; font-size: 24rpx; white-space: nowrap; }
.filter-item.active { background: #e3f2fd; color: #1976d2; }
.card { margin-bottom: 20rpx; }
.header { display: flex; justify-content: space-between; margin-bottom: 16rpx; }
.name { font-weight: bold; font-size: 30rpx; }
.status { font-size: 24rpx; padding: 4rpx 12rpx; border-radius: 4rpx; }
.status-0 { background: #fff3e0; color: #ff9800; }
.status-1 { background: #e3f2fd; color: #2196f3; }
.status-2 { background: #e8f5e9; color: #4caf50; }
.status-3, .status-4 { background: #fce4ec; color: #f44336; }
.info { color: #666; font-size: 26rpx; display: flex; flex-direction: column; gap: 8rpx; }
.meta { margin-top: 8rpx; color: #999; font-size: 22rpx; display: flex; flex-direction: column; gap: 6rpx; }
.reject { margin-top: 8rpx; color: #d32f2f; font-size: 24rpx; background: #ffebee; padding: 8rpx 12rpx; border-radius: 8rpx; }
.amount { margin-top: 16rpx; color: #f44336; font-weight: bold; font-size: 32rpx; }
.actions { margin-top: 14rpx; display: flex; justify-content: flex-end; }
.cancel-btn { color: #f44336; border-color: #f44336; background: #fff; }
.report-btn { color: #2196f3; border-color: #2196f3; background: #fff; }
.error { margin: 16rpx 0; color: #d32f2f; font-size: 24rpx; text-align: center; }
.footer { text-align: center; color: #999; font-size: 24rpx; padding: 16rpx 0 6rpx; }
