.favorites-page { padding: 16rpx; }
.card { display: flex; padding: 20rpx; background: #fff; border-radius: 12rpx; margin-bottom: 16rpx; }
.cover { width: 160rpx; height: 120rpx; border-radius: 8rpx; margin-right: 16rpx; background: #f2f2f2; }
.content { flex: 1; }
.title { font-size: 32rpx; font-weight: 600; color: #333; margin-bottom: 8rpx; }
.price { font-size: 28rpx; color: #e53935; }
.empty { text-align: center; padding: 60rpx 0; color: #999; }
