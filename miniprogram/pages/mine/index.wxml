<view class="mine-page">
  <view class="user-card card" wx:if="{{isLogin}}">
    <image class="avatar" src="{{userInfo.avatar || '/images/tab-mine.png'}}" mode="aspectFill"/>
    <view class="info"><text class="nickname">{{userInfo.real_name || userInfo.nickname || '用户'}}</text><text class="phone">{{userInfo.phone || '未绑定手机'}}</text></view>
  </view>
  <view class="user-card card login-card" wx:else bindtap="onLogin"><text>点击登录</text></view>
  <view class="menu-list card">
    <view class="menu-item" bindtap="goToAppointments"><text>📅 我的预约</text><text class="arrow">›</text></view>
    <view class="menu-item" bindtap="goToReports"><text>📋 体检报告</text><text class="arrow">›</text></view>
    <view class="menu-item" bindtap="goToArticles"><text>🩺 健康常识</text><text class="arrow">›</text></view>
    <view class="menu-item" bindtap="goToConsultations"><text>💬 在线咨询</text><text class="arrow">›</text></view>
    <view class="menu-item" bindtap="goToFavorites"><text>⭐ 我的收藏</text><text class="arrow">›</text></view>
    <view class="menu-item" bindtap="goToProfile"><text>👤 资料编辑</text><text class="arrow">›</text></view>
    <view class="menu-item" bindtap="goToAdmin"><text>🛠 管理端入口</text><text class="arrow">›</text></view>
  </view>
  <button class="logout-btn" wx:if="{{isLogin}}" bindtap="onLogout">退出登录</button>
</view>
