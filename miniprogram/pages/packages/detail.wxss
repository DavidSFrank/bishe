.detail-page { padding-bottom: 120rpx; }
.cover { width: 100%; height: 400rpx; }
.info { margin: -60rpx 20rpx 20rpx; position: relative; z-index: 1; }
.name { font-size: 36rpx; font-weight: bold; margin-bottom: 16rpx; }
.price-row { display: flex; align-items: baseline; gap: 16rpx; }
.original { font-size: 24rpx; color: #999; text-decoration: line-through; }
.tags { margin-top: 16rpx; }
.section { margin: 0 20rpx 20rpx; }
.section-title { font-weight: bold; margin-bottom: 16rpx; color: #333; }
.bottom-bar { position: fixed; bottom: 0; left: 0; right: 0; padding: 20rpx 30rpx; background: #fff; box-shadow: 0 -2rpx 20rpx rgba(0,0,0,0.05); display: flex; gap: 20rpx; }
.bottom-bar .btn-primary { flex: 1; }
.bottom-bar .btn-secondary { flex: 0 0 200rpx; background: #fff; color: #2196F3; border: 2rpx solid #2196F3; }
.empty { text-align: center; color: #999; padding: 120rpx 24rpx; }
