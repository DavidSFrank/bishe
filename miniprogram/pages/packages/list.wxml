<view class="packages-page">
  <input class="search-input" placeholder="搜索套餐" value="{{keyword}}" bindinput="onSearch" bindconfirm="onSearchConfirm" />

  <scroll-view class="category-scroll" scroll-x>
    <view class="category-list">
      <view
        class="category-item {{currentCategory === item.id ? 'active' : ''}}"
        wx:for="{{categories}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onCategoryChange"
      >
        {{item.name}}
      </view>
    </view>
  </scroll-view>

  <view class="package-card card" wx:for="{{packages}}" wx:key="id" data-id="{{item.id}}" bindtap="onPackageTap">
    <image class="package-image" src="{{item.displayImage}}" mode="aspectFill"/>
    <view class="package-content">
      <view class="package-name">{{item.name}}</view>
      <view class="package-desc">{{item.suitable_for || ''}}</view>
      <view class="package-bottom">
        <text class="price">{{item.price}}</text>
        <text class="sales">已售 {{item.sales_count || 0}}</text>
      </view>
    </view>
  </view>

  <view class="empty" wx:if="{{!loading && packages.length === 0}}"><text>{{texts.listEmpty}}</text></view>
</view>
