.packages-page { padding: 20rpx; }
.search-input { background: #fff; padding: 20rpx; border-radius: 12rpx; margin-bottom: 20rpx; }
.category-bar { display: flex; gap: 12rpx; overflow-x: auto; margin-bottom: 18rpx; }
.category-item { padding: 10rpx 22rpx; border-radius: 999rpx; background: #f3f4f6; color: #666; font-size: 24rpx; white-space: nowrap; }
.category-item.active { background: #e3f2fd; color: #1976d2; }
.package-card { display: flex; margin-bottom: 20rpx; }
.package-image { width: 180rpx; height: 180rpx; border-radius: 12rpx 0 0 12rpx; }
.package-info { flex: 1; padding: 20rpx; display: flex; flex-direction: column; justify-content: space-between; }
.package-name { font-size: 30rpx; font-weight: bold; }
