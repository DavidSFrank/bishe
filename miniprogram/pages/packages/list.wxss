.packages-page { padding: 20rpx; }
.search-input { background: #fff; padding: 20rpx; border-radius: 12rpx; margin-bottom: 20rpx; }

.category-scroll { white-space: nowrap; margin-bottom: 20rpx; }
.category-list { display: inline-flex; gap: 12rpx; }
.category-item { padding: 10rpx 20rpx; border-radius: 24rpx; background: #f1f5f9; color: #475569; font-size: 24rpx; }
.category-item.active { background: #2196f3; color: #fff; }

.package-card { display: flex; margin-bottom: 16rpx; }
.package-image { width: 200rpx; height: 150rpx; border-radius: 10rpx; background: #f2f2f2; }
.package-content { flex: 1; margin-left: 16rpx; display: flex; flex-direction: column; }
.package-name { font-size: 30rpx; font-weight: bold; color: #1f2937; }
.package-desc { margin-top: 8rpx; font-size: 24rpx; color: #6b7280; }
.package-bottom { margin-top: auto; display: flex; justify-content: space-between; align-items: center; }
.price { color: #ef4444; font-size: 30rpx; font-weight: 600; }
.sales { color: #9ca3af; font-size: 22rpx; }

.empty { text-align: center; padding: 70rpx 0; color: #9ca3af; }
