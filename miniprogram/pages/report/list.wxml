<view class="list-page">
  <view class="card {{focusReportId === item.id ? 'focus' : ''}}" wx:for="{{reports}}" wx:key="id">
    <view class="title">体检报告 - {{item.displayTitleDate}}</view>
    <view class="meta">报告医生：{{item.displayDoctor}}</view>
    <view class="summary">{{item.displaySummary}}</view>
    <view class="actions">
      <button class="preview-btn" size="mini" bindtap="onPreview" data-report="{{item}}" loading="{{previewingId === item.id}}">{{texts.previewButton}}</button>
    </view>
  </view>
  <view class="empty" wx:if="{{!loading && reports.length === 0}}"><text>{{texts.emptyList}}</text></view>
</view>
