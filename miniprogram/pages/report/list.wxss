.list-page { padding: 20rpx; }
.card { margin-bottom: 18rpx; }
.card.focus { border: 2rpx solid #2196f3; border-radius: 10rpx; padding: 14rpx; }
.title { font-weight: bold; margin-bottom: 12rpx; }
.meta { color: #999; font-size: 24rpx; margin-bottom: 8rpx; }
.summary { color: #666; font-size: 26rpx; }
.actions { margin-top: 16rpx; display: flex; justify-content: flex-end; }
.preview-btn { background: #fff; color: #2196f3; border-color: #2196f3; }
.empty { text-align: center; color: #999; padding: 80rpx 24rpx; }
